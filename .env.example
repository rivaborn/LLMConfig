# LLMConfig configuration. Copy to `.env` and edit. `.env` is gitignored — keep secrets here only.
# Every value below has a sane default in llmconfig/config.py; uncomment to override.

# --- the control app itself ---
LLMCONFIG_HOST=0.0.0.0
LLMCONFIG_PORT=11430                 # avoids 11434 (ollama) / 11436 (vllm) / 11437 (relay)
LLMCONFIG_API_KEY=                   # optional; if set, write ops (load/unload/pull/...) require X-API-Key

# --- Ollama (Windows-native) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_SERVICE_NAME=ollama           # Windows service name (Get-/Start-/Restart-Service)

# --- vLLM (WSL2) ---
VLLM_RELAY_URL=http://127.0.0.1:11437   # socat relay; use 127.0.0.1, NOT localhost (IPv4 happy-eyeballs)
VLLM_SERVE_SCRIPT=/home/folar/vllm/serve.sh
VLLM_SYSTEMD_UNIT=vllm@                  # templated systemd-user unit; instance name = serve.sh alias
VLLM_VENV_ACTIVATE=/home/folar/vllm/.venv/bin/activate  # sourced before `hf download` (hf isn't on the login PATH)

# --- WSL plumbing ---
WSL_DISTRO=Ubuntu-24.04
WSL_USER=folar

# --- GPU (primary lane = RTX 3090) ---
GPU_UUID=GPU-739bece9-8298-7993-f7dd-c8d86cb541f9   # the RTX 3090 (pin by UUID, never index)
VRAM_TOTAL_MB=24576
VRAM_FREE_BASELINE_MB=1500           # "VRAM is freed" / "GPU is maxed" threshold

# --- companion lane (RTX 3070 Ti) — optional 2nd GPU; off unless enabled ---
# Setup: deploy\install-companion.ps1 (2nd Ollama) + serve-companion.sh / a 2nd socat
# relay / vllm-companion@.service for companion vLLM. See deploy/README-deploy.md.
COMPANION_ENABLED=false
COMPANION_GPU_UUID=GPU-2caf7863-102e-31e5-be4d-5ec860addc78   # the RTX 3070 Ti (pin by UUID)
COMPANION_VRAM_TOTAL_MB=8192
COMPANION_VRAM_FREE_BASELINE_MB=600
COMPANION_OLLAMA_URL=http://127.0.0.1:11435       # 2nd Ollama instance
COMPANION_OLLAMA_SERVICE_NAME=OllamaCompanion
# The companion is an OLLAMA-ONLY lane: `serve-companion.sh` was specified (see
# deploy/vllm-companion@.service) but never written, so its vLLM half does not
# exist. False is the honest state — doctor reports it as configuration rather
# than a permanent failure, the catalogs stop advertising aliases that cannot
# launch, and a vLLM load on this lane refuses immediately instead of first
# evicting the Ollama model that was working. Flip to true only after building
# the script (it must resolve the 3070 Ti's index by UUID via torch).
COMPANION_VLLM_ENABLED=false
COMPANION_VLLM_RELAY_URL=http://127.0.0.1:11438   # 2nd socat relay → companion vLLM
COMPANION_VLLM_SERVE_SCRIPT=/home/folar/vllm/serve-companion.sh
COMPANION_VLLM_SYSTEMD_UNIT=vllm-companion@
# COMPANION_REGISTRY_PATH=./data/vllm_models_companion.yaml
COMPANION_DEFAULT_SERVER=            # ollama | vllm | "" — auto-load on startup
COMPANION_DEFAULT_MODEL=             # Ollama tag or vLLM alias (e.g. qwen3:4b or qwen3-4b)

# --- idle auto-unload (power saving) ---
# Reap a lane's model after sustained inactivity so the card drops from P0 (~117 W
# with a model resident on the 3090) to P8 (~25 W). Activity = a /v1 gateway request,
# a load finishing, or GPU utilization above IDLE_UNLOAD_UTIL_PCT (the Monitor signal
# catches clients that hit Ollama / the vLLM relay directly). Reaped models reload
# automatically on the next /v1 request; when no lane serves vLLM the WSL keepalive
# is also released so the distro can idle-shutdown.
IDLE_UNLOAD_ENABLED=true
IDLE_UNLOAD_AFTER_MIN=15             # minutes of no gateway traffic / GPU util
COMPANION_IDLE_UNLOAD_ENABLED=false  # 3070 Ti exempt by default: it idles at ~13 W (P8)
                                     # even with a model resident, and reaping it would
                                     # cost the /swap echo relay its instant response
# PRIMARY_IDLE_UNLOAD_ENABLED=true   # set false to pin the 3090's model (e.g. vl32 as a
                                     # daily-driver vision service) without disabling the
                                     # reaper's fleet-wide usage/idle_s tracking
# IDLE_UNLOAD_CHECK_INTERVAL_S=60
# IDLE_UNLOAD_UTIL_PCT=5             # util above this counts as activity
# USAGE_ACTIVE_WINDOW_S=60           # /api/usage: activity within this = "active"

# --- HuggingFace (vLLM model downloads) ---
HF_TOKEN=                            # or rely on WSL's ~/.cache/huggingface/token

# --- paths / tuning ---
# REGISTRY_PATH=./data/vllm_models.yaml
# EVICT_TIMEOUT_S=45
# POLL_INTERVAL_S=2
# DEFAULT_VLLM_LOAD_TIMEOUT_S=240

# --- DGX Spark cluster (4× GB10, driven by sparkrun from this box's WSL) ---
# Each Spark is an independent LLM "unit" alongside the two GPU lanes: it appears
# on the Home dashboard, gets its own tab, and shows up in the Monitor. There is no
# Ollama-vs-vLLM arbitration and no eviction-wait gate — a node's ~121 GB unified
# pool holds SPARK_MAX_MODELS workloads at once, one per slot port, admitted against
# the mem_fraction each catalog entry declares.
#
# Prereqs on the control box: sparkrun installed in WSL (`uvx sparkrun setup
# install`), a saved cluster, passwordless SSH from WSL to each node, and the SSH
# user in each node's `docker` group. See the wiki runbook
# `runbooks/local-llm-server-dgx-spark` (§ Cluster operations).
SPARK_ENABLED=false
# id=host[=name], comma separated. Default = the as-built site-A cluster.
# SPARK_NODES=spark1=192.168.1.50=spark-cc9b,spark2=192.168.1.51=spark-4cd0,spark3=192.168.1.52=spark-b984,spark4=192.168.1.53=spark-f04a
# SPARK_SSH_USER=fksogbetun
# SPARK_API_PORT=8000                # first slot port; model N serves on API_PORT+N
# SPARK_MAX_MODELS=4                 # models one node may hold at once (slot ports 8000-8003)
# SPARK_MEM_HEADROOM=0.95            # summed mem_fraction a node may reach; loads past it are refused
# SPARK_CLUSTER=sparks               # saved sparkrun cluster name
# SPARK_VRAM_TOTAL_MB=122880         # ~120 GiB usable; GB10 reports memory.total as [N/A]
# SPARK_LOAD_TIMEOUT_S=900           # cold starts pull large weights
# SPARK_IDLE_UNLOAD_ENABLED=false    # Sparks idle at ~25 W and reload slowly — exempt
#
# sparkrun's flags shift between releases, so the command templates are settings
# rather than code. Placeholders: {cluster} {host} {recipe} {tp} {port} {served} {user} {command} {extra}
# Verified against sparkrun 0.2.40 (2026-07-24) by --dry-run on the live cluster.
# Three flags are load-bearing: --cluster alongside --hosts (the cluster carries the
# SSH user; --hosts alone falls back to the local WSL user and every node returns
# Permission denied), --no-follow (else `run` tails logs and never returns), and
# a TARGET or --all on stop (else it exits "Must specify TARGET or --all.").
# SPARK_RUN_CMD=sparkrun run {recipe} --cluster {cluster} --hosts {host} --tp {tp} --port {port} --served-model-name {served} --no-follow {extra}
# SPARK_STOP_CMD=sparkrun stop --all --cluster {cluster} --hosts {host}          # free the whole node
# SPARK_STOP_JOB_CMD=sparkrun stop {job} --cluster {cluster}                      # one model, by JOB ID from `sparkrun status`
# (stop-by-recipe prints success and stops NOTHING — verified live 2026-07-26; and
#  `sparkrun stop` returns 0 even when every SSH fails, so never trust its rc)
# SPARK_STOP_ONE_CMD=sparkrun stop {recipe} --cluster {cluster} --hosts {host}   # BROKEN — kept as a tombstone
# SPARK_STATUS_CMD=sparkrun status --cluster {cluster}
# SPARK_SSH_CMD=ssh -o BatchMode=yes -o ConnectTimeout=5 {user}@{host} {command}

# --- multi-node Spark loading (the Cluster tab; SparkGroup units) ---
# One tensor-parallel model across 2-4 nodes over the 200G fabric. MASTER GATE:
# false (the default) keeps the whole feature inert — no group units, placement
# byte-for-byte as before, POST /api/cluster/load refuses — while the Cluster tab
# still works as a planner. Flip to true once `sparkrun setup cx7` has brought the
# fabric up — `--topology direct` per pair for direct cabling, `--topology switch`
# across all four once the switch lands.
SPARK_FABRIC_ENABLED=false
# WHICH nodes are cabled to each other. The flag above says a fabric exists; this
# says what shape it is. Comma-separated groups, members joined with '+':
#   spark1+spark2,spark3+spark4    two directly-cabled pairs (no switch)
#   spark1+spark2+spark3+spark4    one switched fabric, any-to-any
# A launch is refused unless its node set fits INSIDE one group (subset, so a
# switched 4-node fabric still admits 2-node jobs). Empty = unconstrained,
# byte-for-byte the behaviour from before this setting existed.
# ⚠ Set this whenever the nodes are NOT all-to-all. With direct pairs the
# addresses come from ONE subnet across all four nodes, so spark1 and spark3 look
# same-subnet but share no wire — a tp job across them HANGS (Ray/NCCL waiting on
# a peer that cannot answer) rather than failing. This turns that into a 400.
# SPARK_FABRIC_LINKS=spark1+spark2,spark3+spark4
# Multi-host launch template. {hosts} = comma-joined member addresses (head first);
# {tp} = member count K. Comma-joined --hosts + --tp VERIFIED 2026-07-30 against
# sparkrun 0.2.40 by `sparkrun run … --dry-run` on the live cluster (renders
# --tensor-parallel-size K with --distributed-executor-backend ray).
# SPARK_RUN_MULTI_CMD=sparkrun run {recipe} --cluster {cluster} --hosts {hosts} --tp {tp} --port {port} --served-model-name {served} --no-follow {extra}
# SPARK_CLUSTER_REGISTRY_PATH=./data/spark_cluster_models.yaml   # multi-node recipes live ONLY here
# SPARK_GROUP_STATE_PATH=./data/spark_group_state.yaml           # recorded (model, node-set) placements

# --- auto-placement (/v1 picks the unit when the client names none) ---
# A request without X-LLM-Lane (or with X-LLM-Lane: auto) is placed by LLMConfig:
# resident unit first, then free capacity, then eviction of idle unleased models.
# Explicit X-LLM-Lane pins as before; the chosen unit is echoed as X-LLM-Unit.
AUTO_PLACE_ENABLED=true              # false = no-header falls back to "primary" exactly as before
# PLACEMENT_CACHE_TTL_S=2.0          # placer status-sweep TTL; staleness only mis-ranks
# Proven-load gate: only CHOOSE a unit where the model has launched successfully
# before (LoadTimes sample or current residency; Sparks prove fleet-wide, lanes
# per-unit). Sole-candidate pins and resident models are exempt — that's how a
# first-ever load gets seeded (or load once with an explicit lane).
# PLACEMENT_REQUIRE_PROVEN=true
# PLACEMENT_FAIL_BLOCK_AFTER=2       # consecutive launch failures before a unit is skipped (0 = off)
# PLACEMENT_FAIL_BLOCK_COOLDOWN_S=1800
# PLACEMENT_TAGS_TTL_S=15            # per-lane Ollama tag-list cache (placement's only I/O)
# Workload tiering: interactive requests (small prompt + bounded generation)
# prefer the 3090 (speed tier); batch/bulk (long prompt, big max_tokens, pooling
# bodies) prefer the Sparks (capacity tier) even over an idle lane. The
# X-LLM-Workload header (interactive|batch) overrides the heuristic.
# PLACEMENT_WORKLOAD_ENABLED=true
# PLACEMENT_INTERACTIVE_MAX_PROMPT_CHARS=16000   # ~4k tokens
# PLACEMENT_INTERACTIVE_MAX_NEW_TOKENS=2048

# --- leases (resource sharing between callers) ---
# A lease is a caller's claim on one unit: "I'm using this, and here's whether you
# may take it from me." Callers POST /api/leases with a `holder` label, get back a
# lease id, and send it as `X-LLM-Lease` on /v1 requests. A displaced holder learns
# via GET /api/leases/{id} (state=revoked, with who took it and why) and via an
# in-band 409 on its next /v1 call.
#
# ADVISORY BY DESIGN: clients that bypass LLMConfig (direct Ollama on :11434/:11435,
# the vLLM relay on :11437) cannot be gated, so a non-preemptible lease is a
# cooperation contract, not a hard exclusivity guarantee.
LEASE_ENABLED=true
# X-LLM-Hold: <holder> — a client with a STATIC config (no dynamic lease id) asks the
# gateway to hold the model it is using. Preemptible: shields it from the idle reaper
# and from auto-placement eviction, without 409-ing anyone else. Each request renews,
# so the hold lapses AUTO_HOLD_TTL_S after the client's last request.
AUTO_HOLD_ENABLED=true
# AUTO_HOLD_TTL_S=600                # 10 min of silence before the model is displaceable
# LEASE_DEFAULT_TTL_S=600            # renewable leash when a claim omits ttl_s
# LEASE_MIN_TTL_S=30
# LEASE_MAX_TTL_S=7200               # claims are CLAMPED to this, never refused
# LEASE_EXPIRY_GRACE_S=30            # past expiry: still renewable, no longer blocking
# LEASE_SWEEP_INTERVAL_S=5
# LEASE_MAX_HISTORY=100              # terminal leases kept so "why did I lose it?" still answers
# LEASE_BLOCKS_IDLE_UNLOAD=true      # a live lease stops the idle reaper (card stays in P0)
# LEASE_BLOCK_UNLEASED=true          # non-preemptible lease 409s un-leased /v1 traffic
# LEASE_UNUSED_RELEASE_S=300         # reap a never-used lease on a free unit; 0 disables
# LEASE_STREAM_REJECT_MODE=http      # http = real 409 | sse = in-band error chunk at 200
